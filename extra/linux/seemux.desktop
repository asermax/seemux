[Desktop Entry]
Type=Application
Name=Seemux
GenericName=Terminal Emulator
Comment=GTK4 terminal multiplexer for Claude Code
Exec=seemux
Icon=seemux
Terminal=false
StartupNotify=true
StartupWMClass=com.asermax.seemux
Categories=System;TerminalEmulator;Utility;
Keywords=shell;prompt;command;terminal;multiplexer;claude;
Actions=quake-mode;

[Desktop Action quake-mode]
Name=Quake Mode
Exec=seemux --quake
Icon=seemux
